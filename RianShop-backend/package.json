{
  "name": "rianshop-backend",
  "version": "2.0.0",
  "private": true,
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "lint": "find api src -name '*.js' -print0 | xargs -0 -n1 node --check && if [ -d test ]; then find test -name '*.js' -print0 | xargs -0 -r -n1 node --check; fi && node --check server.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@libsql/client": "0.15.15",
    "axios": "1.20.0",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "4.22.3",
    "jsonwebtoken": "9.0.2",
    "zaileys": "4.16.0"
  }
}
